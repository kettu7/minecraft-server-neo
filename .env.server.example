# Variablen für den Server-Betrieb (docker-compose.server.yml).
# In Komodo beim Stack unter "Environment" eintragen – NICHT als Datei ins Repo legen.
# Alle Passwörter/Tokens NEU erzeugen, nicht die vom lokalen PC übernehmen.

DOMAIN=minecraft-neo.de

# Traefik (aus der Konfiguration des vorhandenen Traefik übernehmen)
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Arbeitsspeicher für Minecraft (höchstens ca. 2/3 des Server-RAMs)
MC_MEMORY=6G

# Lange Zufallswerte, z. B. mit:  openssl rand -base64 32
RCON_PASSWORD=
CONTROL_TOKEN=

# Discord-Anwendung (Developer Portal → OAuth2). Redirect: https://minecraft-neo.de/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
