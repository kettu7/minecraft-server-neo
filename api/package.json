{
  "name": "neo-api",
  "version": "0.1.0",
  "private": true,
  "description": "API für Minecraft Server Neo: Bauprojekte und Materiallisten",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/server.ts",
    "start": "node --env-file-if-exists=../.env src/server.ts",
    "test": "node --env-file=test/test.env --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "items": "node scripts/build-items.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.3",
    "adm-zip": "^0.6.1",
    "fastify": "^5.12.7",
    "prismarine-nbt": "^2.8.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2"
  }
}
