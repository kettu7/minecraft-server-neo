# Kopieren nach .env und Passwort setzen
RCON_PASSWORD=bitte-aendern

# Discord-Login (https://discord.com/developers/applications → App "Neo" → OAuth2)
DISCORD_CLIENT_ID=deine-client-id
# Client-Secret dort per "Reset Secret" erzeugen und hier eintragen – niemals committen oder teilen
DISCORD_CLIENT_SECRET=
# Optional: Nur Mitglieder dieses Discord-Servers dürfen sich anmelden (Server-ID, leer = alle)
DISCORD_GUILD_ID=
# Adresse der Website (Weiterleitung nach dem Login: <PUBLIC_URL>/api/auth/discord/callback)
PUBLIC_URL=http://localhost:4200

# Backups (Standard: stündlich, 24 h alle behalten, danach 1 pro Tag für 14 Tage)
BACKUP_INTERVAL_MINUTES=60
BACKUP_KEEP_HOURS=24
BACKUP_KEEP_DAYS=14

# Interner Steuerdienst (neo-control)
CONTROL_TOKEN=langes-zufaelliges-token
